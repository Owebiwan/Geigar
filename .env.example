# Copy to .env. The file is git-ignored; never commit a real token (NF-5).

# Free token from https://transparency.entsoe.eu (My Account -> Web API security token).
# Leave empty to use SMARD, which needs no token.
ENTSOE_TOKEN=

# 720 replays BDO_REPLAY_DAY in about two minutes. Use 1 and an empty day for live mode.
BDO_SPEED=720
BDO_REPLAY_DAY=2025-10-14

# Trains and scores the price forecaster on first start. It downloads five more years of
# history and adds several minutes. Set to false for a faster first start; the model can
# then be started from the BACKTEST screen.
BDO_INIT_FORECAST=true

BDO_PORT=8080
